Step 3: Enter the program
6.	Copy the following complete program into exp1_ciphers.py and save it. It includes the source practical’s Caesar and two-rail even/odd Rail Fence method.
def caesar_encrypt(text, shift):
    result = ""
    shift %= 26
    for char in text:
        if char.isupper():
            result += chr((ord(char) - 65 + shift) % 26 + 65)
        elif char.islower():
            result += chr((ord(char) - 97 + shift) % 26 + 97)
        else:
            result += char
    return result

def caesar_decrypt(text, shift):
    return caesar_encrypt(text, -shift)

def rail_fence_encrypt(text):
    # Two-rail even/odd transposition used in the source practical
    return text[::2] + text[1::2]

def rail_fence_decrypt(text):
    even_count = (len(text) + 1) // 2
    even_part = text[:even_count]
    odd_part = text[even_count:]
    result = []
    for i, char in enumerate(even_part):
        result.append(char)
        if i < len(odd_part):
            result.append(odd_part[i])
    return "".join(result)

message = input("Enter a message: ")
shift = int(input("Enter the Caesar shift value: "))

encrypted = caesar_encrypt(message, shift)
print("Caesar encrypted:", encrypted)
print("Caesar decrypted:", caesar_decrypt(encrypted, shift))

rail_encrypted = rail_fence_encrypt(message)
print("Rail Fence encrypted:", rail_encrypted)
print("Rail Fence decrypted:", rail_fence_decrypt(rail_encrypted))

